CODEX_IMAGE=ghcr.io/minaduki-shigure/codex-docker:latest
CODEX_CONFIG_DIR=./config
CODEX_WORKSPACE_DIR=./workspace

# Optional provider credentials, supplied only at container runtime.
OPENCODE_GO_API_KEY=
OPENAI_API_KEY=

# For a macOS host proxy, for example: http://host.docker.internal:6152
CODEX_HTTP_PROXY=
CODEX_HTTPS_PROXY=
CODEX_ALL_PROXY=
CODEX_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal
